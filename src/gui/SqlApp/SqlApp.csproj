<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>SqlApp</ApplicationTitle>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.sqlapp</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>SqlApp</ApplicationPublisher>
    <!-- Package Description -->
    <Description>SqlApp powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>

    <!-- Unpackaged .exe mode (No MSIX required) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <ProjectReference Include="..\..\bindings\SqlEngine.Core\SqlEngine.Core.csproj" />
  </ItemGroup>


  <!-- 1. OS별 표준 runtimes 폴더 매핑 (크로스플랫폼 배포용) -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes')">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- 2. 로컬 빌드 증분 복사 (현재 OS의 build 폴더에서 자동 감지) -->
  <ItemGroup>
    <!-- Windows -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\build\sql_engine.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\build\sql_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sql_engine.dll</Link>
      <Visible>false</Visible>
    </None>
    <!-- Linux -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\build\libsql_engine.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\build\libsql_engine.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libsql_engine.so</Link>
      <Visible>false</Visible>
    </None>
    <!-- macOS -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\build\libsql_engine.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\build\libsql_engine.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libsql_engine.dylib</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
